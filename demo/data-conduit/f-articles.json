        { "from": "api.articles.make_comment_on_article", "to": "db.article", "label": "slugで記事検索", "kind": "db" },
        { "from": "db.article", "to": "svc.error.article_not_found", "label": "該当slugなし", "branch": "error", "kind": "error" },
        { "from": "api.articles.make_comment_on_article", "to": "svc.comment.__init__", "label": "コメントを生成", "kind": "call" },
        { "from": "svc.comment.__init__", "to": "db.userprofile", "label": "投稿者プロフィールを紐付け", "kind": "db" },
        { "from": "api.articles.make_comment_on_article", "to": "svc.crud.save", "label": "コメントを保存", "kind": "call" },
        { "from": "svc.crud.save", "to": "db.comment", "label": "コメントレコードをコミット", "kind": "db" },
        { "from": "api.articles.make_comment_on_article", "to": "svc.schema.comment_schema", "label": "作成結果をシリアライズ", "kind": "call" }
      ],
