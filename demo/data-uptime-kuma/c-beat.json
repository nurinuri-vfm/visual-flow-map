{
  "nodes": [
    { "id": "svc.monitor.start", "lane": "svc", "label": "監視ループ起動", "detail": "Monitor.start()。previousBeat/retriesを初期化しbeat/safeBeatを定義。push型以外は即座にsafeBeat()を実行", "ref": "server/model/monitor.js:414" },
    { "id": "job.monitor.beat", "lane": "job", "label": "1回分の監視処理", "detail": "1回のハートビート実行。種別ごとに疎通確認し、成否をheartbeatに格納してDB保存・通知・次回スケジュールまで行う", "ref": "server/model/monitor.js:426" },
    { "id": "job.monitor.safeBeat", "lane": "job", "label": "beatを例外保護実行", "detail": "beat()をtry/catchで保護。例外時はログを出しinterval秒後にsafeBeatを再設定して自己修復する", "ref": "server/model/monitor.js:1091" },
    { "id": "svc.monitor.isUnderMaintenance", "lane": "svc", "label": "メンテナンス判定", "detail": "monitor_maintenanceの紐づけを辿り、いずれかのMaintenanceが稼働中ならtrue。親監視も再帰的に確認", "ref": "server/model/monitor.js:1596" },
    { "id": "svc.maintenance.isUnderMaintenance", "lane": "svc", "label": "メンテ状態を判定", "detail": "Maintenance.getStatus()が'under-maintenance'かどうかを返す", "ref": "server/model/maintenance.js:394" },
    { "id": "svc.monitorType.check", "lane": "svc", "label": "type別チェック契約", "detail": "MonitorType基底クラスのcheck()。各サブクラスがoverrideして実チェックを実装する契約(未overrideは例外)", "ref": "server/monitor-types/monitor-type.js:33" },
    { "id": "svc.tcp.check", "lane": "svc", "label": "TCP監視の疎通確認", "detail": "TCPMonitorType.check()。tcp-pingでポート疎通を確認しUPを設定、失敗時は例外を投げる", "ref": "server/monitor-types/tcp.js:106" },
    { "id": "svc.dns.check", "lane": "svc", "label": "DNS監視の疎通確認", "detail": "DnsMonitorType.check()。DNS解決し条件式に一致すればUP、しなければ例外", "ref": "server/monitor-types/dns.js:22" },
    { "id": "ext.http_target", "lane": "ext", "label": "HTTP監視対象サイト", "detail": "axiosでHTTPリクエストする対象。ステータスコードやキーワードで成否判定される", "ref": "server/model/monitor.js:649" },
    { "id": "ext.tcp_target", "lane": "ext", "label": "TCP監視対象ホスト", "detail": "tcp-pingでポート疎通確認する対象ホスト", "ref": "server/monitor-types/tcp.js:127" },
    { "id": "ext.dns_target", "lane": "ext", "label": "DNSリゾルバ", "detail": "指定したDNSサーバへ名前解決を要求する対象", "ref": "server/monitor-types/dns.js:27" },
    { "id": "svc.monitor.isImportantBeat", "lane": "svc", "label": "状態遷移の重要度判定", "detail": "isFirstBeatまたはUP/DOWN/PENDING/MAINTENANCE間の重要な遷移かを判定しbean.importantを決める", "ref": "server/model/monitor.js:1385" },
    { "id": "svc.monitor.isImportantForNotification", "lane": "svc", "label": "通知要否の判定", "detail": "isImportantBeatに近いが、MAINTENANCE絡みの遷移(UP/DOWN⇄MAINTENANCE)は通知対象から除外する", "ref": "server/model/monitor.js:1420" },
    { "id": "svc.monitor.sendNotification", "lane": "svc", "label": "状態変化を通知", "detail": "isFirstBeatかstatus=DOWNのとき、監視に紐づく通知先を取得し各Notification.send()を呼ぶ", "ref": "server/model/monitor.js:1452" },
    { "id": "svc.monitor.getNotificationList", "lane": "svc", "label": "通知先一覧を取得", "detail": "notificationとmonitor_notificationを結合し、当該監視の通知設定を取得", "ref": "server/model/monitor.js:1526" },
    { "id": "svc.notification.send", "lane": "svc", "label": "通知送信ディスパッチ", "detail": "notification.typeに応じたプロバイダのsend()を呼ぶ。未対応typeは例外", "ref": "server/notification.js:250" },
    { "id": "ext.notification_provider", "lane": "ext", "label": "通知先サービス", "detail": "Notification providerのsend()が実際に叩く外部通知サービス/Webhook(Discord等)", "ref": "server/notification.js:252" },
    { "id": "svc.uptime.getUptimeCalculator", "lane": "svc", "label": "計算機を取得/生成", "detail": "monitorIDごとにUptimeCalculatorをキャッシュし、無ければinit()して生成する", "ref": "server/uptime-calculator.js:72" },
    { "id": "svc.uptime.update", "lane": "svc", "label": "稼働率データ更新", "detail": "分/時/日単位の集計にup/down/maintenance件数とping平均を積算し、テスト環境以外はDBへ保存", "ref": "server/uptime-calculator.js:212" },
    { "id": "svc.uptime.getData", "lane": "svc", "label": "稼働率データ集計", "detail": "get24Hour/30Day/1Year経由。指定期間分のup/down/pingを合算し稼働率%を算出", "ref": "server/uptime-calculator.js:563" },
    { "id": "svc.monitor.sendStats", "lane": "svc", "label": "統計をUIへ配信", "detail": "対象ユーザーのルームに接続中クライアントがいればavgPing/uptime/証明書/ドメイン情報をsocket配信", "ref": "server/model/monitor.js:1315" },
    { "id": "db.monitor", "lane": "db", "label": "monitorテーブル", "detail": "監視設定(URL/種別/しきい値/maxretries/resendInterval等)を保持", "ref": "db/knex_init_db.js:66" },
    { "id": "db.heartbeat", "lane": "db", "label": "heartbeatテーブル", "detail": "1回ごとの監視結果(status/ping/msg/retries/important等)を保存", "ref": "db/knex_init_db.js:125" },
    { "id": "db.monitor_tls_info", "lane": "db", "label": "TLS証明書情報テーブル", "detail": "監視ごとの最新TLS証明書情報(info_json)を保持", "ref": "db/knex_init_db.js:359" },
    { "id": "db.notification_sent_history", "lane": "db", "label": "通知送信履歴テーブル", "detail": "証明書/ドメイン期限通知の送信済み記録(type/monitor_id/days)。重複送信を防止", "ref": "db/knex_init_db.js:373" },
    { "id": "db.monitor_maintenance", "lane": "db", "label": "監視×メンテ紐付け", "detail": "監視IDとメンテナンスIDの多対多紐付け", "ref": "db/knex_init_db.js:272" },
    { "id": "db.notification", "lane": "db", "label": "notificationテーブル", "detail": "通知プロバイダ設定(type/config)を保持", "ref": "db/knex_init_db.js:296" },
    { "id": "db.monitor_notification", "lane": "db", "label": "監視×通知紐付け", "detail": "監視IDと通知IDの紐付け", "ref": "db/knex_init_db.js:306" },
    { "id": "db.stat_minutely", "lane": "db", "label": "分次統計テーブル", "detail": "1分単位のup/down/ping集計", "ref": "db/knex_migrations/2023-08-16-0000-create-uptime.js:3" },
    { "id": "db.stat_hourly", "lane": "db", "label": "時次統計テーブル", "detail": "1時間単位のup/down/ping集計", "ref": "db/knex_migrations/2023-12-22-0000-hourly-uptime.js:2" },
    { "id": "db.stat_daily", "lane": "db", "label": "日次統計テーブル", "detail": "1日単位のup/down/ping集計", "ref": "db/knex_migrations/2023-08-16-0000-create-uptime.js:21" },
    { "id": "svc.monitor.handleTlsInfo", "lane": "svc", "label": "TLS情報の受領処理", "detail": "取得したTLS証明書情報をDB保存しPrometheus更新。期限通知が有効なら期限チェックを呼ぶ", "ref": "server/model/monitor.js:2072" },
    { "id": "svc.monitor.updateTlsInfo", "lane": "svc", "label": "TLS証明書情報を保存", "detail": "monitor_tls_infoへ保存。fingerprintが変わっていれば証明書の送信履歴を削除する", "ref": "server/model/monitor.js:1258" },
    { "id": "svc.utilServer.checkCertExpiryNotifications", "lane": "svc", "label": "証明書期限をチェック", "detail": "証明書チェーンを辿り、設定日数(既定7/14/21日)以下ならsendCertNotificationByTargetDaysを呼ぶ", "ref": "server/util-server.js:924" },
    { "id": "svc.monitor.sendCertNotificationByTargetDays", "lane": "svc", "label": "証明書期限を通知", "detail": "同じ日数閾値で未送信ならNotification.send()を呼び、notification_sent_historyへ記録", "ref": "server/model/monitor.js:1544" },
    { "id": "svc.domainExpiry.checkSupport", "lane": "svc", "label": "ドメイン期限対応判定", "detail": "監視typeとhostname/urlからドメインを特定し、ICANN管理下かつRDAP対応TLDかを検証", "ref": "server/model/domain_expiry.js:211" },
    { "id": "svc.domainExpiry.checkExpiry", "lane": "svc", "label": "ドメイン期限を取得", "detail": "domain_expiry行を取得/作成し、前回チェックから1日以上ならRDAPへ再取得して期限日を更新", "ref": "server/model/domain_expiry.js:278" },
    { "id": "svc.domainExpiry.sendNotifications", "lane": "svc", "label": "ドメイン期限通知判定", "detail": "設定日数(既定7/14/21日)ごとに残日数と比較し、未送信ならsendDomainNotificationByTargetDaysを呼ぶ", "ref": "server/model/domain_expiry.js:309" },
    { "id": "svc.domainExpiry.sendDomainNotificationByTargetDays", "lane": "svc", "label": "ドメイン期限通知送信", "detail": "通知先ごとにNotification.send()を呼び出す", "ref": "server/model/domain_expiry.js:150" },
    { "id": "db.domain_expiry", "lane": "db", "label": "domain_expiryテーブル", "detail": "ドメインごとの期限日・最終チェック日・最終通知日数を保持", "ref": "db/knex_migrations/2025-09-02-0000-add-domain-expiry.js:6" },
    { "id": "ext.rdap_server", "lane": "ext", "label": "RDAPサーバ", "detail": "ドメインの有効期限情報を返す外部RDAPサーバへHTTP fetchする", "ref": "server/model/domain_expiry.js:121" },
    { "id": "ext.iana_rdap_directory", "lane": "ext", "label": "IANA RDAPディレクトリ", "detail": "TLDごとのRDAPサーバ一覧を提供する外部データ(週次キャッシュ)", "ref": "server/model/domain_expiry.js:54" }
  ],
  "edges": [],
  "flows": [
    {
      "id": "monitor-check-success",
      "title": "監視が1回実行される(成功)",
      "category": "監視の実行",
      "trigger": "svc.monitor.startがsafeBeatを起動する(push型はinterval秒後、その他は直ちに)",
      "steps": [
        { "from": "svc.monitor.start", "to": "job.monitor.safeBeat", "label": "監視ループを起動", "branch": "normal", "kind": "call", "evidence": "direct" },
        { "from": "job.monitor.safeBeat", "to": "job.monitor.beat", "label": "beat()を実行", "branch": "normal", "kind": "call", "evidence": "direct" },
        { "from": "job.monitor.beat", "to": "svc.monitor.isUnderMaintenance", "label": "メンテナンス中か確認", "branch": "normal", "kind": "call", "evidence": "direct" },
        { "from": "svc.monitor.isUnderMaintenance", "to": "svc.maintenance.isUnderMaintenance", "label": "各メンテのstatusを確認", "branch": "normal", "kind": "call", "evidence": "direct" },
        { "from": "svc.maintenance.isUnderMaintenance", "to": "svc.monitor.isUnderMaintenance", "label": "false(非メンテ)を返す", "branch": "normal", "kind": "return", "evidence": "inferred" },
        { "from": "svc.monitor.isUnderMaintenance", "to": "job.monitor.beat", "label": "false: 通常チェックへ", "branch": "normal", "kind": "return", "evidence": "direct" },
        { "from": "job.monitor.beat", "to": "svc.monitorType.check", "label": "type別チェックを呼ぶ", "branch": "normal", "kind": "call", "evidence": "direct" },
        { "from": "svc.monitorType.check", "to": "svc.tcp.check", "label": "type=portの場合", "branch": "tcp", "kind": "dispatch", "evidence": "unverified" },
        { "from": "svc.tcp.check", "to": "ext.tcp_target", "label": "TCP接続を試行", "branch": "normal", "kind": "call", "evidence": "direct" },
        { "from": "ext.tcp_target", "to": "svc.tcp.check", "label": "応答あり", "branch": "normal", "kind": "return", "evidence": "inferred" },
        { "from": "svc.tcp.check", "to": "job.monitor.beat", "label": "status=UPを設定して復帰", "branch": "normal", "kind": "return", "evidence": "direct" },
        { "from": "svc.monitorType.check", "to": "svc.dns.check", "label": "type=dnsの場合(別実装例)", "branch": "dns", "kind": "dispatch", "evidence": "unverified" },
        { "from": "svc.dns.check", "to": "ext.dns_target", "label": "名前解決を要求", "branch": "normal", "kind": "call", "evidence": "direct" },
        { "from": "job.monitor.beat", "to": "ext.http_target", "label": "type=http/keyword/json-queryの場合(beat内で直接axios実行)", "branch": "http", "kind": "call", "evidence": "direct" },
        { "from": "job.monitor.beat", "to": "svc.monitor.isImportantBeat", "label": "重要度を判定", "branch": "normal", "kind": "call", "evidence": "direct" },
        { "from": "svc.monitor.isImportantBeat", "to": "job.monitor.beat", "label": "重要度を返す", "branch": "normal", "kind": "return", "evidence": "direct" },
        { "from": "job.monitor.beat", "to": "svc.uptime.update", "label": "稼働率を積算", "branch": "normal", "kind": "call", "evidence": "direct" },
        { "from": "job.monitor.beat", "to": "svc.monitor.sendStats", "label": "統計をUIへ配信", "branch": "normal", "kind": "call", "evidence": "direct" },
        { "from": "job.monitor.beat", "to": "db.heartbeat", "label": "ハートビートを保存", "branch": "normal", "kind": "query", "evidence": "direct" },
        { "from": "job.monitor.beat", "to": "job.monitor.safeBeat", "label": "次回分をタイマー予約", "branch": "normal", "kind": "framework", "evidence": "framework" }
      ],
      "notes": [
        "retriesは成功でリセットされる(monitor.js:913)",
        "isFirstBeatの場合はUP確定でもsendNotificationが呼ばれる(monitor.js:968,1437, isImportantForNotification)",
        "tcp.js/dns.jsは代表例。実際に呼ばれるのはUptimeKumaServer.monitorTypeListに登録されたthis.typeに対応するcheck()一つのみで、http/ping/push/mqtt等はbeat()内に直接インライン実装されている(monitor.js:473-903)"
      ]
    },
    {
      "id": "monitor-check-retry",
      "title": "失敗してリトライする",
      "category": "監視の実行",
      "trigger": "job.monitor.beatの疎通確認中に例外が発生し、maxretries未満のためPENDINGとして次回リトライする",
      "steps": [
        { "from": "job.monitor.beat", "to": "svc.monitorType.check", "label": "type別チェックを呼ぶ", "branch": "normal", "kind": "call", "evidence": "direct" },
        { "from": "svc.monitorType.check", "to": "svc.tcp.check", "label": "type=portの場合", "branch": "tcp", "kind": "dispatch", "evidence": "unverified" },
        { "from": "svc.tcp.check", "to": "ext.tcp_target", "label": "TCP接続を試行", "branch": "normal", "kind": "call", "evidence": "direct" },
        { "from": "ext.tcp_target", "to": "svc.tcp.check", "label": "接続失敗/タイムアウト", "branch": "error", "kind": "return", "evidence": "inferred" },
        { "from": "svc.tcp.check", "to": "job.monitor.beat", "label": "'Connection failed'を例外throw", "branch": "error", "kind": "error", "evidence": "direct" },
        { "from": "job.monitor.beat", "to": "job.monitor.beat", "label": "maxretries>0かつretries<maxretriesならretries++しPENDINGに設定", "branch": "error", "kind": "decision", "evidence": "direct" },
        { "from": "job.monitor.beat", "to": "svc.monitor.isImportantBeat", "label": "重要度を判定", "branch": "error", "kind": "call", "evidence": "direct" },
        { "from": "svc.monitor.isImportantBeat", "to": "job.monitor.beat", "label": "UP→PENDING等は重要でない", "branch": "error", "kind": "return", "evidence": "direct" },
        { "from": "job.monitor.beat", "to": "job.monitor.beat", "label": "retryInterval>0なら次回間隔をretryIntervalに変更", "branch": "error", "kind": "decision", "evidence": "direct" },
        { "from": "job.monitor.beat", "to": "db.heartbeat", "label": "PENDINGとして保存", "branch": "error", "kind": "query", "evidence": "direct" },
        { "from": "job.monitor.beat", "to": "svc.uptime.update", "label": "PENDINGはDOWN扱いで集計(pingは加算しない)", "branch": "error", "kind": "call", "evidence": "direct" },
        { "from": "job.monitor.beat", "to": "job.monitor.safeBeat", "label": "retryInterval秒後に再スケジュール", "branch": "error", "kind": "framework", "evidence": "framework" },
        { "from": "job.monitor.safeBeat", "to": "job.monitor.beat", "label": "再度beat()を実行", "branch": "error", "kind": "call", "evidence": "framework" }
      ],
      "notes": [
        "リトライ回数条件: this.maxretries>0 && retries<this.maxretriesのときのみPENDING、それ以外(上限到達)はDOWN確定側の分岐へ進む(monitor.js:939-954)",
        "retryIntervalが未設定/0ならbeatIntervalは変更されない(monitor.js:1036-1037)",
        "json-query型でretry_only_on_status_code_failureが有効な場合、JSON条件不一致は即座にretries=0でDOWN扱いとなる特例がある(monitor.js:929-945)"
      ]
    },
    {
      "id": "monitor-confirm-down",
      "title": "ダウンと確定する",
      "category": "監視の実行",
      "trigger": "リトライ上限に達した(またはmaxretries=0)状態で疎通確認が失敗する",
      "steps": [
        { "from": "job.monitor.beat", "to": "svc.monitorType.check", "label": "type別チェックを呼ぶ", "branch": "normal", "kind": "call", "evidence": "direct" },
        { "from": "svc.monitorType.check", "to": "svc.tcp.check", "label": "type=portの場合", "branch": "tcp", "kind": "dispatch", "evidence": "unverified" },
        { "from": "svc.tcp.check", "to": "ext.tcp_target", "label": "TCP接続を試行", "branch": "normal", "kind": "call", "evidence": "direct" },
        { "from": "ext.tcp_target", "to": "svc.tcp.check", "label": "接続失敗", "branch": "error", "kind": "return", "evidence": "inferred" },
        { "from": "svc.tcp.check", "to": "job.monitor.beat", "label": "例外throw", "branch": "error", "kind": "error", "evidence": "direct" },
        { "from": "job.monitor.beat", "to": "job.monitor.beat", "label": "retries>=maxretriesのためstatus=DOWN(初期値)のまま確定", "branch": "error", "kind": "decision", "evidence": "direct" },
        { "from": "job.monitor.beat", "to": "svc.monitor.isImportantBeat", "label": "重要度を判定", "branch": "error", "kind": "call", "evidence": "direct" },
        { "from": "svc.monitor.isImportantBeat", "to": "job.monitor.beat", "label": "PENDING→DOWNまたはUP→DOWNは重要", "branch": "down_confirmed", "kind": "return", "evidence": "direct" },
        { "from": "job.monitor.beat", "to": "svc.monitor.isImportantForNotification", "label": "通知対象かを判定", "branch": "down_confirmed", "kind": "call", "evidence": "direct" },
        { "from": "svc.monitor.isImportantForNotification", "to": "job.monitor.beat", "label": "true: 通知対象", "branch": "down_confirmed", "kind": "return", "evidence": "direct" },
        { "from": "job.monitor.beat", "to": "svc.monitor.sendNotification", "label": "ダウン通知を送信", "branch": "down_confirmed", "kind": "call", "evidence": "direct" },
        { "from": "svc.monitor.sendNotification", "to": "svc.monitor.getNotificationList", "label": "通知先一覧を取得", "branch": "normal", "kind": "call", "evidence": "direct" },
        { "from": "svc.monitor.getNotificationList", "to": "db.notification", "label": "notification×monitor_notificationを結合取得", "branch": "normal", "kind": "query", "evidence": "direct" },
        { "from": "svc.monitor.getNotificationList", "to": "db.monitor_notification", "label": "監視IDに紐づく通知IDを結合", "branch": "normal", "kind": "query", "evidence": "direct" },
        { "from": "svc.monitor.sendNotification", "to": "svc.notification.send", "label": "各通知先へ送信(Down)", "branch": "normal", "kind": "call", "evidence": "direct" },
        { "from": "svc.notification.send", "to": "ext.notification_provider", "label": "外部通知サービスへ送信", "branch": "normal", "kind": "call", "evidence": "direct" },
        { "from": "job.monitor.beat", "to": "db.heartbeat", "label": "important=true、downCount=0で保存", "branch": "down_confirmed", "kind": "query", "evidence": "direct" },
        { "from": "job.monitor.beat", "to": "svc.uptime.update", "label": "down集計を積算", "branch": "normal", "kind": "call", "evidence": "direct" },
        { "from": "job.monitor.beat", "to": "job.monitor.safeBeat", "label": "次回をスケジュール", "branch": "normal", "kind": "framework", "evidence": "framework" }
      ],
      "notes": [
        "DOWN確定はbean.statusの初期値(DOWN)がそのまま残るケース。upside-down監視の場合はflipStatus()で反転しUP→DOWNになる(monitor.js:459-461,905-910)",
        "通知本文はbean.status===UP以外は'Down'系メッセージ固定(monitor.js:1457-1461)",
        "isImportantBeatがtrueの場合、apicacheのクリアとdownCountのリセットも合わせて行われる(monitor.js:965-985)"
      ]
    },
    {
      "id": "monitor-recover-up",
      "title": "復旧する",
      "category": "監視の実行",
      "trigger": "直前がDOWN(またはPENDING)の状態から疎通確認が成功しUPへ復帰する",
      "steps": [
        { "from": "job.monitor.beat", "to": "svc.monitorType.check", "label": "type別チェックを呼ぶ", "branch": "normal", "kind": "call", "evidence": "direct" },
