        { "from": "api.http.badge_status", "to": "svc.api-router.makeBadge", "label": "状態に応じ色/文言を決定", "kind": "call", "evidence": "direct" },
        { "from": "svc.api-router.makeBadge", "to": "api.http.badge_status", "label": "SVG文字列を返す", "kind": "return", "evidence": "direct" },
        { "from": "api.http.badge_status", "to": "ext.badge_consumer", "label": "image/svg+xmlで応答", "kind": "http", "evidence": "direct" }
