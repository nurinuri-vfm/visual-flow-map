        { "from": "svc.apicache.middleware", "to": "ext.badge_consumer", "label": "キャッシュ済SVGを即返却", "branch": "キャッシュヒット", "kind": "return", "evidence": "framework" },
        { "from": "svc.apicache.middleware", "to": "api.http.badge_status", "label": "ハンドラ本体を実行", "branch": "キャッシュミス", "kind": "middleware", "evidence": "framework" },
        { "from": "api.http.badge_status", "to": "svc.api-router.isMonitorPublic", "label": "公開判定を呼ぶ", "kind": "call", "evidence": "direct" },
        { "from": "svc.api-router.isMonitorPublic", "to": "db.monitor_group", "label": "monitor_group⋈groupを検索", "kind": "query", "evidence": "direct" },
        { "from": "svc.api-router.isMonitorPublic", "to": "db.group", "label": "public=1かを判定", "kind": "query", "evidence": "direct" },
        { "from": "svc.api-router.isMonitorPublic", "to": "api.http.badge_status", "label": "true/falseを返す", "kind": "return", "evidence": "direct" },
        { "from": "api.http.badge_status", "to": "svc.api-router.makeBadge", "label": "N/A(灰色)バッジを構成", "branch": "非公開/モニター無し", "kind": "call", "evidence": "direct" },
