    { "id": "app.socket.onUpdateMonitorIntoList", "lane": "app", "label": "更新差分受信", "detail": "socket.on(\"updateMonitorIntoList\")で該当IDのみ差し替え", "ref": "src/mixins/socket.js:152" },
