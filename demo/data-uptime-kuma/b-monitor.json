    { "id": "app.details.pauseMonitor", "lane": "app", "label": "一時停止送信", "detail": "getSocket().emit(\"pauseMonitor\", monitor.id, cb)を直接呼ぶ", "ref": "src/pages/Details.vue:675" },
    { "id": "app.details.resumeMonitor", "lane": "app", "label": "再開送信", "detail": "getSocket().emit(\"resumeMonitor\", monitor.id, cb)を直接呼ぶ", "ref": "src/pages/Details.vue:665" },
    { "id": "app.details.deleteMonitor", "lane": "app", "label": "削除送信", "detail": "$root.deleteMonitor(monitor.id, deleteChildrenMonitors, cb)を呼ぶ", "ref": "src/pages/Details.vue:717" },
    { "id": "app.details.monitor", "lane": "app", "label": "表示データ参照", "detail": "$route.params.idで$root.monitorListから該当データを参照するだけ(新規取得なし)", "ref": "src/pages/Details.vue:504" },
    { "id": "app.monitorlist.pauseSelected", "lane": "app", "label": "一括一時停止送信", "detail": "選択中の稼働中モニターへpauseMonitorを個別に送信", "ref": "src/components/MonitorList.vue:450" },
    { "id": "app.monitorlist.resumeSelected", "lane": "app", "label": "一括再開送信", "detail": "選択中の停止中モニターへresumeMonitorを個別に送信", "ref": "src/components/MonitorList.vue:474" },
    { "id": "app.monitorlist.deleteSelected", "lane": "app", "label": "一括削除送信", "detail": "選択中モニターへdeleteMonitor(id,false,cb)を1件ずつ送信", "ref": "src/components/MonitorList.vue:497" },

    { "id": "api.socket.connection", "lane": "api", "label": "ソケット接続", "detail": "クライアント接続確立。以降のsocket.onハンドラがこのスコープ内で登録される", "ref": "server/server.js:389" },
