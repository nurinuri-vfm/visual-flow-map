    { "id": "ui.details.delete_btn", "lane": "ui", "label": "削除ボタン", "detail": "詳細画面の削除ボタン", "ref": "src/pages/Details.vue:141" },
    { "id": "ui.details.pause_confirm", "lane": "ui", "label": "一時停止確認", "detail": "一時停止の確認ダイアログ。Yesでpauseに進む", "ref": "src/pages/Details.vue:386" },
    { "id": "ui.details.delete_confirm", "lane": "ui", "label": "削除確認", "detail": "削除の確認ダイアログ。グループなら子削除の可否も選べる", "ref": "src/pages/Details.vue:390" },

    { "id": "app.editmonitor.init", "lane": "app", "label": "フォーム初期化", "detail": "追加時は既定値を設定、編集/複製時はgetMonitorで既存値を取得", "ref": "src/pages/EditMonitor.vue:4012" },
