    { "id": "api.socket.getMonitorList", "lane": "api", "label": "getMonitorList受信", "detail": "一覧の明示的な再取得要求のハンドラ", "ref": "server/server.js:995" },
    { "id": "api.socket.getMonitor", "lane": "api", "label": "getMonitor受信", "detail": "単一モニターの詳細取得(編集/複製フォームの初期表示用)", "ref": "server/server.js:1011" },
    { "id": "api.socket.resumeMonitor", "lane": "api", "label": "resumeMonitor受信", "detail": "モニターの開始/再開のハンドラ", "ref": "server/server.js:1089" },
    { "id": "api.socket.pauseMonitor", "lane": "api", "label": "pauseMonitor受信", "detail": "モニターの一時停止のハンドラ", "ref": "server/server.js:1108" },
    { "id": "api.socket.deleteMonitor", "lane": "api", "label": "deleteMonitor受信", "detail": "モニターの削除ハンドラ。グループは子の扱いを選択可", "ref": "server/server.js:1127" },

    { "id": "svc.auth.checkLogin", "lane": "svc", "label": "ログイン確認", "detail": "socket.userIDが未設定なら例外を投げる", "ref": "server/util-server.js:644" },
    { "id": "svc.server.afterLogin", "lane": "svc", "label": "ログイン後一覧配信", "detail": "ログイン成功時に一覧・通知等をまとめて配信する入口関数", "ref": "server/server.js:1828" },
    { "id": "svc.server.checkOwner", "lane": "svc", "label": "所有者確認", "detail": "指定monitorIDがそのuser_idで存在するか確認。無ければ例外", "ref": "server/server.js:1813" },
    { "id": "svc.server.updateMonitorNotification", "lane": "svc", "label": "通知紐付け更新", "detail": "monitor_notificationを全削除後、選択された通知だけ再作成", "ref": "server/server.js:1793" },
    { "id": "svc.server.startMonitor", "lane": "svc", "label": "開始/再開処理", "detail": "active=1に更新し、既存インスタンスがあればstopしてから再度start", "ref": "server/server.js:1901" },
    { "id": "svc.server.restartMonitor", "lane": "svc", "label": "再起動処理", "detail": "startMonitorを呼び直すだけの薄いラッパー", "ref": "server/server.js:1924" },
    { "id": "svc.server.pauseMonitor", "lane": "svc", "label": "一時停止処理", "detail": "active=0に更新し、稼働中インスタンスがあればstop", "ref": "server/server.js:1934" },
    { "id": "svc.server.sendMonitorList", "lane": "svc", "label": "一覧送信", "detail": "getMonitorJSONListの結果をmonitorListイベントで配信", "ref": "server/uptime-kuma-server.js:222" },
    { "id": "svc.server.sendUpdateMonitorIntoList", "lane": "svc", "label": "更新差分送信", "detail": "指定IDだけ再構築しupdateMonitorIntoListで配信", "ref": "server/uptime-kuma-server.js:234" },
    { "id": "svc.server.sendDeleteMonitorFromList", "lane": "svc", "label": "削除通知送信", "detail": "deleteMonitorFromListイベントでIDのみ配信", "ref": "server/uptime-kuma-server.js:247" },
    { "id": "svc.server.getMonitorJSONList", "lane": "svc", "label": "一覧JSON生成", "detail": "user_idのmonitorをDB取得しtoJSONで整形したオブジェクトを返す", "ref": "server/uptime-kuma-server.js:259" },
    { "id": "svc.monitor.toJSON", "lane": "svc", "label": "JSON変換", "detail": "DBの1行を画面表示用オブジェクトへ変換", "ref": "server/model/monitor.js:116" },
    { "id": "svc.monitor.preparePreloadData", "lane": "svc", "label": "先読みデータ準備", "detail": "通知/タグ/子ID/稼働状態などをまとめて先読み(N+1回避)", "ref": "server/model/monitor.js:1820" },
    { "id": "svc.monitor.isActive", "lane": "svc", "label": "稼働判定", "detail": "自身のactiveと親の稼働状態を合成して最終的な稼働可否を判定", "ref": "server/model/monitor.js:1302" },
    { "id": "svc.monitor.getAllChildrenIDs", "lane": "svc", "label": "子ID列挙", "detail": "子孫モニターのIDを再帰的に取得", "ref": "server/model/monitor.js:1956" },
    { "id": "svc.monitor.getChildren", "lane": "svc", "label": "子取得", "detail": "parent=指定IDの行を取得", "ref": "server/model/monitor.js:1919" },
    { "id": "svc.monitor.unlinkAllChildren", "lane": "svc", "label": "子の親解除", "detail": "子モニターのparentをnullに更新(グループ解除)", "ref": "server/model/monitor.js:1978" },
    { "id": "svc.monitor.deleteMonitor", "lane": "svc", "label": "1件削除", "detail": "稼働中ならstopしてからmonitorテーブルの該当行を削除", "ref": "server/model/monitor.js:1988" },
    { "id": "svc.monitor.deleteMonitorRecursively", "lane": "svc", "label": "再帰削除", "detail": "グループなら子を先に再帰削除してから自身を削除", "ref": "server/model/monitor.js:2007" },
    { "id": "svc.monitor.start", "lane": "svc", "label": "監視開始", "detail": "ハートビートループ(beat)を起動する", "ref": "server/model/monitor.js:414" },
    { "id": "svc.monitor.stop", "lane": "svc", "label": "監視停止", "detail": "setTimeoutを解除しisStop=trueにしてループを止める", "ref": "server/model/monitor.js:1211" },

    { "id": "job.monitor.beat", "lane": "job", "label": "ハートビート実行", "detail": "対象を検査してheartbeatを保存し、次回分をsetTimeoutで再予約する常駐ループ", "ref": "server/model/monitor.js:426" },

    { "id": "db.monitor", "lane": "db", "label": "monitorテーブル", "detail": "id/active/parent/user_id等モニター本体。user_idはON DELETE SET NULL", "ref": "db/knex_init_db.js:66" },
    { "id": "db.heartbeat", "lane": "db", "label": "heartbeatテーブル", "detail": "monitor_idごとの検査結果。monitor削除でON DELETE CASCADE", "ref": "db/knex_init_db.js:125" },
    { "id": "db.monitor_notification", "lane": "db", "label": "通知紐付けテーブル", "detail": "monitor_id×notification_idの中間テーブル。monitor削除でON DELETE CASCADE", "ref": "db/knex_init_db.js:306" }
  ],
  "edges": [],
  "flows": [
    {
      "id": "flow_add_monitor",
      "title": "モニターを追加する",
      "category": "モニター管理",
      "trigger": "サイドバーの「追加」リンクをクリックする",
      "steps": [
        { "from": "ui.layout.add_nav_link", "to": "ui.editmonitor.screen", "label": "/addへ遷移", "kind": "navigate", "evidence": "framework" },
        { "from": "ui.editmonitor.screen", "to": "app.editmonitor.init", "label": "mounted()でinit()を実行", "kind": "call", "evidence": "direct" },
        { "from": "app.editmonitor.init", "to": "ui.editmonitor.screen", "label": "isAddなので既定値をフォームへ設定(サーバ呼出し無し)", "kind": "return", "evidence": "direct" },
        { "from": "ui.editmonitor.screen", "to": "ui.editmonitor.save_btn", "label": "必須項目を入力し保存をクリック", "kind": "ui", "evidence": "direct" },
        { "from": "ui.editmonitor.save_btn", "to": "app.editmonitor.submit", "label": "@submit.prevent=\"submit\"", "kind": "call", "evidence": "direct" },
        { "from": "app.editmonitor.submit", "to": "app.socket.add", "label": "isAdd/isCloneならthis.$root.add()を呼ぶ", "kind": "call", "evidence": "direct" },
        { "from": "app.socket.add", "to": "api.socket.connection", "label": "socket.emit(\"add\", monitor, cb)", "kind": "emit", "evidence": "direct" },
        { "from": "api.socket.connection", "to": "api.socket.add", "label": "addハンドラを起動", "kind": "dispatch", "evidence": "framework" },
        { "from": "api.socket.add", "to": "svc.auth.checkLogin", "label": "checkLogin(socket)", "kind": "call", "evidence": "direct" },
        { "from": "svc.auth.checkLogin", "to": "api.socket.add", "label": "未ログインなら例外", "branch": "error", "kind": "throw", "evidence": "direct" },
        { "from": "api.socket.add", "to": "app.editmonitor.submit", "label": "callback({ok:false,'You are not logged in.'})", "branch": "error", "kind": "return", "evidence": "direct" },
        { "from": "api.socket.add", "to": "app.editmonitor.submit", "label": "accepted_statuscodesが全て文字列でないと保存前に例外", "branch": "error", "kind": "throw", "evidence": "direct" },
        { "from": "api.socket.add", "to": "db.monitor", "label": "R.store(bean)でINSERT", "kind": "write", "evidence": "direct" },
        { "from": "api.socket.add", "to": "svc.server.updateMonitorNotification", "label": "通知IDリストを保存", "kind": "call", "evidence": "direct" },
        { "from": "svc.server.updateMonitorNotification", "to": "db.monitor_notification", "label": "DELETE後に選択分だけINSERT", "kind": "write", "evidence": "direct" },
        { "from": "api.socket.add", "to": "svc.server.sendUpdateMonitorIntoList", "label": "追加した1件だけ配信", "kind": "call", "evidence": "direct" },
        { "from": "svc.server.sendUpdateMonitorIntoList", "to": "svc.server.getMonitorJSONList", "label": "該当IDのみ再構築", "kind": "call", "evidence": "direct" },
        { "from": "svc.server.getMonitorJSONList", "to": "db.monitor", "label": "id指定でR.find", "kind": "read", "evidence": "direct" },
        { "from": "svc.server.getMonitorJSONList", "to": "svc.monitor.preparePreloadData", "label": "先読みデータを準備(詳細は一覧表示フロー参照)", "kind": "call", "evidence": "direct" },
        { "from": "svc.server.getMonitorJSONList", "to": "svc.monitor.toJSON", "label": "toJSON(preloadData)へ整形", "kind": "call", "evidence": "direct" },
        { "from": "svc.server.sendUpdateMonitorIntoList", "to": "app.socket.onUpdateMonitorIntoList", "label": "updateMonitorIntoListを配信", "kind": "emit", "evidence": "direct" },
        { "from": "app.socket.onUpdateMonitorIntoList", "to": "ui.monitorlist.screen", "label": "該当IDだけ$root.monitorListへ反映", "kind": "update", "evidence": "direct" },
        { "from": "api.socket.add", "to": "svc.server.startMonitor", "label": "monitor.active!==falseなら即座に開始", "kind": "call", "evidence": "direct" },
        { "from": "svc.server.startMonitor", "to": "svc.server.checkOwner", "label": "所有者確認", "kind": "call", "evidence": "direct" },
        { "from": "svc.server.startMonitor", "to": "db.monitor", "label": "active=1へUPDATE", "kind": "write", "evidence": "direct" },
        { "from": "svc.server.startMonitor", "to": "svc.monitor.start", "label": "monitor.start(io)を呼ぶ", "kind": "call", "evidence": "direct" },
        { "from": "svc.monitor.start", "to": "job.monitor.beat", "label": "safeBeat()経由でbeatループを起動", "kind": "schedule", "evidence": "direct" },
        { "from": "job.monitor.beat", "to": "db.heartbeat", "label": "検査結果をR.store", "kind": "write", "evidence": "direct" },
        { "from": "job.monitor.beat", "to": "job.monitor.beat", "label": "setTimeoutで次回分を再予約", "kind": "schedule", "evidence": "framework" },
        { "from": "api.socket.add", "to": "app.editmonitor.submit", "label": "callback({ok:true,'successAdded',monitorID})", "kind": "return", "evidence": "direct" },
        { "from": "app.editmonitor.submit", "to": "ui.details.screen", "label": "$router.push('/dashboard/'+monitorID)", "kind": "navigate", "evidence": "direct" }
      ],
      "notes": [
        "accepted_statuscodesが文字列配列でないと保存前にthrowされ、DBには何も書き込まれない",
        "作成時にactiveが明示的にfalseでない限り、保存と同時にstartMonitorが呼ばれて即座に監視が始まる"
      ]
    },
    {
      "id": "flow_edit_monitor",
      "title": "モニターを編集する",
      "category": "モニター管理",
      "trigger": "詳細画面の「編集」リンクをクリックする",
      "steps": [
        { "from": "ui.details.edit_link", "to": "ui.editmonitor.screen", "label": "/edit/:idへ遷移", "kind": "navigate", "evidence": "framework" },
        { "from": "ui.editmonitor.screen", "to": "app.editmonitor.init", "label": "mounted()でinit()を実行", "kind": "call", "evidence": "direct" },
        { "from": "app.editmonitor.init", "to": "api.socket.connection", "label": "isEdit/isCloneならgetMonitorを直接emit(app.socket.*は経由しない)", "kind": "emit", "evidence": "direct" },
        { "from": "api.socket.connection", "to": "api.socket.getMonitor", "label": "getMonitorハンドラを起動", "kind": "dispatch", "evidence": "framework" },
        { "from": "api.socket.getMonitor", "to": "svc.auth.checkLogin", "label": "checkLogin(socket)", "kind": "call", "evidence": "direct" },
        { "from": "svc.auth.checkLogin", "to": "api.socket.getMonitor", "label": "未ログインなら例外", "branch": "error", "kind": "throw", "evidence": "direct" },
        { "from": "api.socket.getMonitor", "to": "app.editmonitor.init", "label": "callback({ok:false})", "branch": "error", "kind": "return", "evidence": "direct" },
        { "from": "api.socket.getMonitor", "to": "db.monitor", "label": "id+user_idで1件取得", "kind": "read", "evidence": "direct" },
        { "from": "db.monitor", "to": "api.socket.getMonitor", "label": "該当行なしだとmonitor=undefinedとなりmonitor.id参照でTypeError", "branch": "error", "kind": "throw", "evidence": "direct" },
        { "from": "api.socket.getMonitor", "to": "svc.monitor.preparePreloadData", "label": "先読みデータを準備", "kind": "call", "evidence": "direct" },
        { "from": "api.socket.getMonitor", "to": "svc.monitor.toJSON", "label": "monitor.toJSON(preloadData)", "kind": "call", "evidence": "direct" },
        { "from": "api.socket.getMonitor", "to": "app.editmonitor.init", "label": "callback({ok:true, monitor})", "kind": "return", "evidence": "direct" },
        { "from": "app.editmonitor.init", "to": "ui.editmonitor.screen", "label": "取得した値をフォームへ反映", "kind": "update", "evidence": "direct" },
