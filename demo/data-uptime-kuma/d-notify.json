      "trigger": "HTTPS監視のビートで TLS 情報を取得したとき",
      "steps": [
        { "from": "job.monitor.beat", "to": "svc.monitor.handleTlsInfo", "label": "TLS情報を保存", "kind": "call" },
        { "from": "svc.monitor.handleTlsInfo", "to": "job.monitor.safeBeat", "label": "期限通知OFFなら何もしない", "branch": "alt", "kind": "timer" },
        { "from": "svc.monitor.handleTlsInfo", "to": "svc.util-server.checkCertExpiryNotifications", "label": "残日数を判定", "kind": "call" },
        { "from": "svc.util-server.checkCertExpiryNotifications", "to": "db.monitor_notification", "label": "宛先を取得(0件なら終了)", "kind": "db" },
        { "from": "svc.util-server.checkCertExpiryNotifications", "to": "db.setting", "label": "閾値日数を取得(既定7/14/21)", "kind": "db" },
        { "from": "svc.util-server.checkCertExpiryNotifications", "to": "svc.monitor.sendCertNotificationByTargetDays", "label": "閾値以下の証明書ごとに通知", "kind": "call" },
        { "from": "svc.monitor.sendCertNotificationByTargetDays", "to": "db.notification_sent_history", "label": "送信済みなら送らない", "kind": "db" },
        { "from": "svc.monitor.sendCertNotificationByTargetDays", "to": "svc.notification.send", "label": "残り日数を本文にして送信", "kind": "call" },
        { "from": "svc.notification.send", "to": "svc.smtp.send", "label": "種類ごとの実装を呼ぶ", "kind": "call" },
        { "from": "svc.smtp.send", "to": "ext.smtp.server", "label": "メールを送信", "kind": "email" },
        { "from": "svc.monitor.sendCertNotificationByTargetDays", "to": "db.notification_sent_history", "label": "1件でも成功したら履歴を記録", "kind": "db" },
        { "from": "svc.monitor.sendCertNotificationByTargetDays", "to": "svc.util-server.checkCertExpiryNotifications", "label": "全宛先失敗なら履歴を残さない", "branch": "error", "kind": "error" }
      ],
      "notes": [
        "全宛先で送信に失敗すると履歴が残らないため、次のビートでまた送信を試みる(復旧後に重複しにくい設計)",
        "既知のルート証明書に当たった時点でそのチェーンの探索を打ち切る。中間証明書は issuerCertificate を辿って全部見る",
        "履歴の判定が days <= targetDays のため、短い閾値で送った後に長い閾値では送られない",
        "tlsExpiryNotifyDays が未設定または配列でない場合、その場で [7,14,21] を DB に書き戻す"
      ]
    },
    {
      "id": "notify-apprise-check",
      "title": "Apprise が入っているか確認する",
      "category": "通知",
      "trigger": "通知の種類で Apprise を選んでフォームが表示された",
      "steps": [
        { "from": "ui.notificationdialog.type_select", "to": "app.apprise.checkApprise", "label": "Appriseフォームが mounted", "kind": "call" },
        { "from": "app.apprise.checkApprise", "to": "api.socket.connection", "label": "checkApprise を送る", "kind": "realtime" },
        { "from": "api.socket.connection", "to": "api.socket.checkApprise", "label": "受口へ振り分け", "kind": "realtime" },
        { "from": "api.socket.checkApprise", "to": "svc.auth.checkLogin", "label": "ログイン確認", "kind": "call" },
        { "from": "svc.auth.checkLogin", "to": "ui.apprise.status", "label": "例外なら無条件で false", "branch": "error", "kind": "error" },
        { "from": "api.socket.checkApprise", "to": "svc.notification.checkApprise", "label": "コマンドの有無を確認", "kind": "call" },
        { "from": "svc.notification.checkApprise", "to": "ext.apprise.cli", "label": "apprise の存在を照会", "kind": "call" },
        { "from": "api.socket.checkApprise", "to": "ui.apprise.status", "label": "導入済み/未導入を表示", "kind": "realtime" },
        { "from": "ui.apprise.status", "to": "svc.apprise.send", "label": "実際の送信は spawn で行う", "branch": "alt", "kind": "call" },
        { "from": "svc.apprise.send", "to": "ext.apprise.cli", "label": "apprise コマンドを起動", "kind": "call" },
        { "from": "ext.apprise.cli", "to": "svc.apprise.send", "label": "出力に ERROR を含めば失敗", "branch": "error", "kind": "error" }
      ],
      "notes": [
        "checkApprise は未ログイン時も catch で false を返すため、「未インストール」と「未認証」が画面上で区別できない",
        "確認しているのはコマンドの存在だけ。実行権限やバージョンは見ていない",
        "送信結果の判定は stdout の文字列マッチ。出力が空だと「No output from apprise」を成功扱いで返す"
      ]
    }
  ]
}
