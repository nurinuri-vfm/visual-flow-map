{
  "nodes": [
    { "id": "ui.setup.mounted_check", "lane": "ui", "label": "Setup screen initial check", "detail": "Re-checks needSetup when the screen mounts; if it is false, setup is already done and the user is sent back to the top page", "ref": "src/pages/Setup.vue:89" },
    { "id": "ui.setup.submit_btn", "lane": "ui", "label": "Create button", "detail": "Button that submits setup with a username, a password and a password confirmation", "ref": "src/pages/Setup.vue:100" },
    { "id": "ui.login.submit_btn", "lane": "ui", "label": "Login button", "detail": "Button that submits login with username/password (plus a 2FA token if required)", "ref": "src/components/Login.vue:111" },
    { "id": "ui.header.logout_btn", "lane": "ui", "label": "Logout button", "detail": "The logout item in the header dropdown", "ref": "src/layouts/Layout.vue:109" },
    { "id": "ui.security.change_password_form", "lane": "ui", "label": "Change password form", "detail": "Form for submitting the current password and the new password (entered twice)", "ref": "src/components/settings/Security.vue:18" },
    { "id": "ui.two_fa.enable_btn", "lane": "ui", "label": "Enable 2FA button", "detail": "Button that requests QR code issuance (prepare2FA), gated on the current password", "ref": "src/components/TwoFADialog.vue:59" },
    { "id": "ui.two_fa.verify_btn", "lane": "ui", "label": "Verify token button", "detail": "Button that verifies the 6-digit code shown by the authenticator app on the spot", "ref": "src/components/TwoFADialog.vue:85" },
    { "id": "ui.two_fa.save_btn", "lane": "ui", "label": "Save 2FA button", "detail": "Button that runs save2FA through a confirm dialog and commits 2FA", "ref": "src/components/TwoFADialog.vue:101" },
    { "id": "ui.api_keys.add_btn", "lane": "ui", "label": "Add API key button", "detail": "Button that opens the API key issue dialog (APIKeyDialog)", "ref": "src/components/settings/APIKeys.vue:8" },
    { "id": "ui.api_key_dialog.generate_btn", "lane": "ui", "label": "Generate key button", "detail": "Button that generates an API key with a name and an expiry date", "ref": "src/components/APIKeyDialog.vue:50" },

    { "id": "app.socket.initSocketIO", "lane": "app", "label": "Socket init", "detail": "Opens the socket.io connection and registers the event listeners (setup / loginRequired / autoLogin and others)", "ref": "src/mixins/socket.js:85" },
    { "id": "app.socket.login", "lane": "app", "label": "Login emit", "detail": "Emits username/password/token on the login event and stores the token on success", "ref": "src/mixins/socket.js:412" },
    { "id": "app.socket.loginByToken", "lane": "app", "label": "Token login", "detail": "Emits loginByToken with the stored JWT and calls logout() on failure", "ref": "src/mixins/socket.js:445" },
    { "id": "app.socket.logout", "lane": "app", "label": "Logout emit", "detail": "After emitting logout, deletes the stored token and clears local state", "ref": "src/mixins/socket.js:462" },
    { "id": "app.socket.getSocket", "lane": "app", "label": "Direct socket access", "detail": "Returns the socket.io instance. Several screens emit directly through it", "ref": "src/mixins/socket.js:346" },
    { "id": "app.socket.addAPIKey", "lane": "app", "label": "Add API key emit", "detail": "Sends the key details on the addAPIKey event", "ref": "src/mixins/socket.js:648" },

    { "id": "api.socket.connection", "lane": "api", "label": "Socket connection accepted", "detail": "Entry point when a socket.io connection is established. Every socket handler is registered here", "ref": "server/server.js:389" },
    { "id": "api.socket.needSetup", "lane": "api", "label": "needSetup received", "detail": "Returns the needSetup flag decided at server start, as is", "ref": "server/server.js:701" },
    { "id": "api.socket.setup", "lane": "api", "label": "setup received", "detail": "Creates the first admin account. Has a strength check and a guard against double initialization", "ref": "server/server.js:705" },
    { "id": "api.socket.login", "lane": "api", "label": "login received", "detail": "Does the credential check, the 2FA branch and JWT issuance", "ref": "server/server.js:450" },
    { "id": "api.socket.loginByToken", "lane": "api", "label": "loginByToken received", "detail": "Verifies the JWT and detects a password change (shake256 comparison) to log the user in automatically", "ref": "server/server.js:401" },
    { "id": "api.socket.logout", "lane": "api", "label": "logout received", "detail": "Only does socket.leave and clears userID (no DB update)", "ref": "server/server.js:530" },
    { "id": "api.socket.changePassword", "lane": "api", "label": "changePassword received", "detail": "After the strength check and the current-password re-check, updates the password and returns a new token", "ref": "server/server.js:1446" },
    { "id": "api.socket.prepare2FA", "lane": "api", "label": "prepare2FA received", "detail": "After the current-password check, generates a TOTP secret, stores it in the DB and returns the QR URI", "ref": "server/server.js:544" },
    { "id": "api.socket.verifyToken", "lane": "api", "label": "verifyToken received", "detail": "After the current-password check, only verifies the submitted token against twofa_secret (changes no state)", "ref": "server/server.js:646" },
    { "id": "api.socket.save2FA", "lane": "api", "label": "save2FA received", "detail": "After the current-password check, sets twofa_status to 1 and commits 2FA", "ref": "server/server.js:587" },
    { "id": "api.socket.addAPIKey", "lane": "api", "label": "addAPIKey received", "detail": "Generates and stores an API key, then turns the apiKeysEnabled setting on", "ref": "server/socket-handlers/api-key-socket-handler.js:18" },

    { "id": "svc.auth.checkLogin", "lane": "svc", "label": "Check logged in", "detail": "Throws if socket.userID is not set", "ref": "server/util-server.js:644" },
    { "id": "svc.util.doubleCheckPassword", "lane": "svc", "label": "Re-check current password", "detail": "Re-checks the signed-in user's current password by hash comparison", "ref": "server/util-server.js:658" },
    { "id": "svc.auth.login", "lane": "svc", "label": "Credential check", "detail": "Looks the user up by TRIMmed username with active=1, verifies with bcrypt and rehashes when needed", "ref": "server/auth.js:15" },
    { "id": "svc.user.resetPassword", "lane": "svc", "label": "Reset password", "detail": "Hashes the new password and updates the user table (instance method)", "ref": "server/model/user.js:27" },
    { "id": "svc.user.createJWT", "lane": "svc", "label": "Issue JWT", "detail": "Signs a JWT that carries the username and a shake256 digest of the current password", "ref": "server/model/user.js:41" },
    { "id": "svc.server.afterLogin", "lane": "svc", "label": "After-login setup", "detail": "Sets socket.userID, joins the room and sends the initial lists (monitors, notifications, API keys and more)", "ref": "server/server.js:1828" },
    { "id": "svc.api_key.save", "lane": "svc", "label": "Save API key", "detail": "Creates a new api_key record from the hashed key details it receives", "ref": "server/model/api_key.js:60" },
    { "id": "svc.settings.set", "lane": "svc", "label": "Save setting value", "detail": "Upserts into the setting table and drops the internal cache", "ref": "server/settings.js:71" },

    { "id": "db.user", "lane": "db", "label": "user table", "detail": "Holds username / password / twofa_status / twofa_secret and so on", "ref": "db/knex_init_db.js:54" },
    { "id": "db.api_key", "lane": "db", "label": "api_key table", "detail": "Holds the hash, the expiry and the enabled flag of every issued API key", "ref": "db/knex_init_db.js:442" },
    { "id": "db.setting", "lane": "db", "label": "setting table", "detail": "Holds key-value app settings (apiKeysEnabled and others)", "ref": "db/knex_init_db.js:383" }
  ],
  "edges": [],
  "flows": [
    {
      "id": "setup_initial",
      "title": "First-time setup",
      "category": "Auth & account",
      "trigger": "Connecting to the app while not a single user has been registered",
      "steps": [
        { "from": "api.socket.connection", "to": "app.socket.initSocketIO", "label": "Not initialized, so setup is announced", "kind": "emit", "evidence": "inferred" },
        { "from": "app.socket.initSocketIO", "to": "ui.setup.mounted_check", "label": "Navigate to the /setup screen", "kind": "navigate", "evidence": "framework" },
        { "from": "ui.setup.mounted_check", "to": "app.socket.getSocket", "label": "Re-check needSetup", "kind": "call", "evidence": "direct" },
        { "from": "app.socket.getSocket", "to": "api.socket.needSetup", "label": "Ask for needSetup", "kind": "emit", "evidence": "inferred" },
        { "from": "api.socket.needSetup", "to": "ui.setup.mounted_check", "label": "Return the needSetup result", "kind": "return", "evidence": "framework" },
        { "from": "api.socket.needSetup", "to": "ui.setup.mounted_check", "label": "If false, send back to the top page", "branch": "alt", "kind": "navigate", "evidence": "direct" },
        { "from": "ui.setup.submit_btn", "to": "app.socket.getSocket", "label": "Submit username/password", "kind": "call", "evidence": "direct" },
        { "from": "app.socket.getSocket", "to": "api.socket.setup", "label": "Emit the setup request", "kind": "emit", "evidence": "inferred" },
        { "from": "api.socket.setup", "to": "ui.setup.submit_btn", "label": "Password too weak error", "branch": "error", "kind": "return", "evidence": "direct" },
        { "from": "api.socket.setup", "to": "db.user", "label": "Count the registered users", "kind": "db_read", "evidence": "direct" },
        { "from": "api.socket.setup", "to": "ui.setup.submit_btn", "label": "Already initialized error", "branch": "error", "kind": "return", "evidence": "direct" },
        { "from": "api.socket.setup", "to": "db.user", "label": "Create the admin account", "kind": "db_write", "evidence": "direct" },
        { "from": "api.socket.setup", "to": "ui.setup.submit_btn", "label": "Creation success callback", "kind": "return", "evidence": "framework" },
        { "from": "ui.setup.submit_btn", "to": "app.socket.login", "label": "Auto-login right after creation", "kind": "call", "evidence": "direct" },
        { "from": "app.socket.login", "to": "api.socket.login", "label": "Emit the login request", "kind": "emit", "evidence": "inferred" },
        { "from": "api.socket.login", "to": "svc.auth.login", "label": "Check the credentials", "kind": "call", "evidence": "direct" },
        { "from": "svc.auth.login", "to": "db.user", "label": "Look the user up", "kind": "db_read", "evidence": "direct" },
        { "from": "api.socket.login", "to": "svc.server.afterLogin", "label": "Establish the session", "kind": "call", "evidence": "direct" },
        { "from": "svc.server.afterLogin", "to": "ui.setup.submit_btn", "label": "Login done, go to the top page", "kind": "navigate", "evidence": "direct" }
      ],
      "notes": [
        "The automatic login after a successful setup takes the same path as a normal login (everything from svc.auth.login onward). The first user has no 2FA configured, so that branch never fires."
      ]
    },
    {
      "id": "login",
      "title": "Login",
      "category": "Auth & account",
      "trigger": "Entering a username and a password on the login screen and submitting",
      "steps": [
        { "from": "ui.login.submit_btn", "to": "app.socket.login", "label": "Submit the login form", "kind": "call", "evidence": "direct" },
        { "from": "app.socket.login", "to": "api.socket.login", "label": "Emit the login request", "kind": "emit", "evidence": "inferred" },
        { "from": "api.socket.login", "to": "svc.auth.login", "label": "Check the credentials", "kind": "call", "evidence": "direct" },
        { "from": "svc.auth.login", "to": "db.user", "label": "Look the user up (TRIM username, active=1)", "kind": "db_read", "evidence": "direct" },
        { "from": "svc.auth.login", "to": "api.socket.login", "label": "No match, so null is returned", "branch": "error", "kind": "return", "evidence": "direct" },
        { "from": "api.socket.login", "to": "ui.login.submit_btn", "label": "authIncorrectCreds error", "branch": "error", "kind": "return", "evidence": "framework" },
        { "from": "api.socket.login", "to": "svc.server.afterLogin", "label": "2FA off, so login is immediate", "kind": "call", "evidence": "direct" },
        { "from": "api.socket.login", "to": "svc.user.createJWT", "label": "Issue JWT", "kind": "call", "evidence": "direct" },
        { "from": "svc.user.createJWT", "to": "api.socket.login", "label": "Return the token", "kind": "return", "evidence": "direct" },
        { "from": "api.socket.login", "to": "ui.login.submit_btn", "label": "Login succeeded (token)", "kind": "return", "evidence": "framework" },
        { "from": "api.socket.login", "to": "ui.login.submit_btn", "label": "Ask for the 2FA token", "branch": "alt", "kind": "return", "evidence": "framework" },
        { "from": "ui.login.submit_btn", "to": "app.socket.login", "label": "Resend with the OTP", "branch": "alt", "kind": "call", "evidence": "direct" },
        { "from": "app.socket.login", "to": "api.socket.login", "label": "Emit the login request (with token)", "branch": "alt", "kind": "emit", "evidence": "inferred" },
        { "from": "api.socket.login", "to": "db.user", "label": "Verify TOTP and check last_token reuse", "branch": "alt", "kind": "check", "evidence": "direct" },
        { "from": "api.socket.login", "to": "ui.login.submit_btn", "label": "authInvalidToken error", "branch": "error", "kind": "return", "evidence": "direct" },
        { "from": "api.socket.login", "to": "db.user", "label": "Update twofa_last_token", "branch": "alt", "kind": "db_write", "evidence": "direct" },
        { "from": "api.socket.login", "to": "svc.server.afterLogin", "label": "2FA verified, login confirmed", "branch": "alt", "kind": "call", "evidence": "direct" },
        { "from": "api.socket.login", "to": "svc.user.createJWT", "label": "Issue JWT", "branch": "alt", "kind": "call", "evidence": "direct" },
        { "from": "svc.user.createJWT", "to": "api.socket.login", "label": "Return the token", "branch": "alt", "kind": "return", "evidence": "direct" },
        { "from": "api.socket.login", "to": "ui.login.submit_btn", "label": "Login succeeded (token)", "branch": "alt", "kind": "return", "evidence": "framework" }
      ],
      "notes": [
        "A token identical to twofa_last_token is treated as invalid, to stop reuse (server.js:495)."
      ]
    },
    {
      "id": "auto_login_by_token",
      "title": "Auto-login with a token",
      "category": "Auth & account",
      "trigger": "Starting the app with a stored JWT and opening the socket connection",
      "steps": [
        { "from": "app.socket.initSocketIO", "to": "api.socket.connection", "label": "Socket connection established", "kind": "connect", "evidence": "framework" },
        { "from": "api.socket.connection", "to": "app.socket.initSocketIO", "label": "Not logged in, so loginRequired is sent", "kind": "emit", "evidence": "inferred" },
        { "from": "app.socket.initSocketIO", "to": "app.socket.loginByToken", "label": "Try auto-login with the stored token", "kind": "call", "evidence": "direct" },
        { "from": "app.socket.initSocketIO", "to": "ui.login.submit_btn", "label": "No stored token, so the login screen is shown", "branch": "alt", "kind": "return", "evidence": "direct" },
        { "from": "app.socket.loginByToken", "to": "api.socket.loginByToken", "label": "Emit the loginByToken request", "kind": "emit", "evidence": "inferred" },
        { "from": "api.socket.loginByToken", "to": "db.user", "label": "Look the user up by the username in the JWT", "kind": "db_read", "evidence": "direct" },
        { "from": "api.socket.loginByToken", "to": "app.socket.loginByToken", "label": "authUserInactiveOrDeleted error", "branch": "error", "kind": "return", "evidence": "framework" },
        { "from": "api.socket.loginByToken", "to": "db.user", "label": "Detect a password change (shake256 comparison)", "kind": "check", "evidence": "direct" },
        { "from": "api.socket.loginByToken", "to": "app.socket.loginByToken", "label": "authInvalidToken error", "branch": "error", "kind": "return", "evidence": "framework" },
        { "from": "api.socket.loginByToken", "to": "svc.server.afterLogin", "label": "Token is valid, login confirmed", "kind": "call", "evidence": "direct" },
        { "from": "svc.server.afterLogin", "to": "api.socket.loginByToken", "label": "Session established", "kind": "return", "evidence": "direct" },
        { "from": "api.socket.loginByToken", "to": "app.socket.loginByToken", "label": "Login success callback", "kind": "return", "evidence": "framework" },
        { "from": "app.socket.loginByToken", "to": "ui.login.submit_btn", "label": "Reflect the logged-in state on screen", "kind": "return", "evidence": "direct" },
        { "from": "app.socket.loginByToken", "to": "app.socket.logout", "label": "Token invalid, so log out", "branch": "error", "kind": "call", "evidence": "direct" }
      ],
      "notes": [
        "When disableAuth is on, an autoLogin event is sent instead of loginRequired and this path (loginByToken) is never taken (server.js:1751-1754)."
      ]
    },
    {
      "id": "logout",
      "title": "Logout",
      "category": "Auth & account",
      "trigger": "Pressing the logout button in the header",
      "steps": [
        { "from": "ui.header.logout_btn", "to": "app.socket.logout", "label": "Press the logout button", "kind": "call", "evidence": "direct" },
        { "from": "app.socket.logout", "to": "api.socket.logout", "label": "Emit the logout request", "kind": "emit", "evidence": "inferred" },
        { "from": "api.socket.logout", "to": "app.socket.logout", "label": "Rate limit exceeded, no callback", "branch": "error", "kind": "return", "evidence": "direct" },
        { "from": "api.socket.logout", "to": "app.socket.logout", "label": "Empty callback after leaving the room and dropping userID", "kind": "return", "evidence": "framework" },
        { "from": "app.socket.logout", "to": "ui.header.logout_btn", "label": "Drop the stored token, back to login", "kind": "return", "evidence": "direct" }
      ],
      "notes": [
        "The logout handler never touches the DB (only socket.leave and clearing userID). The JWT itself is not revoked, so sessions on other devices stay alive."
      ]
    },
    {
      "id": "change_password",
      "title": "Change password",
      "category": "Auth & account",
      "trigger": "Submitting the change password form on the settings screen",
      "steps": [
        { "from": "ui.security.change_password_form", "to": "ui.security.change_password_form", "label": "New passwords differ, submit aborted", "branch": "error", "kind": "check", "evidence": "direct" },
        { "from": "ui.security.change_password_form", "to": "app.socket.getSocket", "label": "Submit the change form", "kind": "call", "evidence": "direct" },
        { "from": "app.socket.getSocket", "to": "api.socket.changePassword", "label": "Emit the changePassword request", "kind": "emit", "evidence": "inferred" },
        { "from": "api.socket.changePassword", "to": "svc.auth.checkLogin", "label": "Check login", "kind": "check", "evidence": "direct" },
        { "from": "svc.auth.checkLogin", "to": "ui.security.change_password_form", "label": "Not logged in error", "branch": "error", "kind": "return", "evidence": "direct" },
        { "from": "api.socket.changePassword", "to": "ui.security.change_password_form", "label": "Password too weak error", "branch": "error", "kind": "return", "evidence": "direct" },
        { "from": "api.socket.changePassword", "to": "svc.util.doubleCheckPassword", "label": "Re-check the current password", "kind": "call", "evidence": "direct" },
        { "from": "svc.util.doubleCheckPassword", "to": "db.user", "label": "Hash-compare the current password", "kind": "db_read", "evidence": "direct" },
        { "from": "svc.util.doubleCheckPassword", "to": "ui.security.change_password_form", "label": "Current password mismatch error", "branch": "error", "kind": "return", "evidence": "direct" },
        { "from": "api.socket.changePassword", "to": "svc.user.resetPassword", "label": "Hash and set the new password", "kind": "call", "evidence": "direct" },
        { "from": "svc.user.resetPassword", "to": "db.user", "label": "Update the password hash", "kind": "db_write", "evidence": "direct" },
        { "from": "api.socket.changePassword", "to": "svc.user.createJWT", "label": "Issue a new token", "kind": "call", "evidence": "direct" },
        { "from": "svc.user.createJWT", "to": "api.socket.changePassword", "label": "Return the token", "kind": "return", "evidence": "direct" },
        { "from": "api.socket.changePassword", "to": "ui.security.change_password_form", "label": "Changed, new token applied", "kind": "return", "evidence": "framework" }
      ],
      "notes": [
        "On success, server.disconnectAllSocketClients(user.id, socket.id) force-disconnects every session except this socket (server.js:1461). Those other sessions are not drawn in this map."
      ]
    },
    {
      "id": "enable_2fa",
      "title": "Enable 2FA",
      "category": "Auth & account",
      "trigger": "Pressing the enable button (prepare2FA) under \"2FA Settings\" on the settings screen",
      "steps": [
        { "from": "ui.two_fa.enable_btn", "to": "app.socket.getSocket", "label": "Start 2FA prep (send current password)", "kind": "call", "evidence": "direct" },
        { "from": "app.socket.getSocket", "to": "api.socket.prepare2FA", "label": "Emit the prepare2FA request", "kind": "emit", "evidence": "inferred" },
        { "from": "api.socket.prepare2FA", "to": "svc.auth.checkLogin", "label": "Check login", "kind": "check", "evidence": "direct" },
        { "from": "svc.auth.checkLogin", "to": "ui.two_fa.enable_btn", "label": "Not logged in error", "branch": "error", "kind": "return", "evidence": "direct" },
        { "from": "api.socket.prepare2FA", "to": "svc.util.doubleCheckPassword", "label": "Check the current password", "kind": "call", "evidence": "direct" },
        { "from": "svc.util.doubleCheckPassword", "to": "db.user", "label": "Hash-compare the current password", "kind": "db_read", "evidence": "direct" },
        { "from": "svc.util.doubleCheckPassword", "to": "ui.two_fa.enable_btn", "label": "Current password mismatch error", "branch": "error", "kind": "return", "evidence": "direct" },
        { "from": "api.socket.prepare2FA", "to": "ui.two_fa.enable_btn", "label": "2FA already enabled error", "branch": "error", "kind": "return", "evidence": "direct" },
        { "from": "api.socket.prepare2FA", "to": "db.user", "label": "Generate and store twofa_secret", "kind": "db_write", "evidence": "direct" },
        { "from": "api.socket.prepare2FA", "to": "ui.two_fa.enable_btn", "label": "Return the QR code URI", "kind": "return", "evidence": "framework" },
        { "from": "ui.two_fa.verify_btn", "to": "app.socket.getSocket", "label": "Ask to verify the entered token", "kind": "call", "evidence": "direct" },
        { "from": "app.socket.getSocket", "to": "api.socket.verifyToken", "label": "Emit the verifyToken request", "kind": "emit", "evidence": "inferred" },
        { "from": "api.socket.verifyToken", "to": "svc.auth.checkLogin", "label": "Check login", "kind": "check", "evidence": "direct" },
        { "from": "api.socket.verifyToken", "to": "svc.util.doubleCheckPassword", "label": "Check the current password", "kind": "call", "evidence": "direct" },
        { "from": "svc.util.doubleCheckPassword", "to": "db.user", "label": "Hash-compare the current password", "kind": "db_read", "evidence": "direct" },
        { "from": "api.socket.verifyToken", "to": "db.user", "label": "Verify TOTP (reads twofa_secret)", "kind": "check", "evidence": "direct" },
        { "from": "api.socket.verifyToken", "to": "ui.two_fa.verify_btn", "label": "authInvalidToken error", "branch": "error", "kind": "return", "evidence": "direct" },
        { "from": "api.socket.verifyToken", "to": "ui.two_fa.verify_btn", "label": "Verified (valid:true)", "kind": "return", "evidence": "framework" },
        { "from": "ui.two_fa.save_btn", "to": "app.socket.getSocket", "label": "Run save2FA via the confirm dialog", "kind": "call", "evidence": "direct" },
        { "from": "app.socket.getSocket", "to": "api.socket.save2FA", "label": "Emit the save2FA request", "kind": "emit", "evidence": "inferred" },
        { "from": "api.socket.save2FA", "to": "svc.auth.checkLogin", "label": "Check login", "kind": "check", "evidence": "direct" },
