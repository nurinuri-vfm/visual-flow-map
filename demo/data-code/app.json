{
  "nodes": [
    {
      "id": "ui.order.create_btn",
      "lane": "ui",
      "label": "「注文を確定する」ボタン",
      "detail": "注文画面の確定ボタン。カートの内容で POST /orders を送る。在庫不足なら409でトーストを出す",
      "ref": "web/orderPage.js:6"
    },
    {
      "id": "ui.order.cancel_btn",
      "lane": "ui",
      "label": "「キャンセルする」ボタン",
      "detail": "注文詳細のキャンセルボタン。失敗時はトーストで再試行を促す",
      "ref": "web/orderPage.js:17"
    },
    {
      "id": "app.client.post_json",
      "lane": "app",
      "label": "postJson（API共通）",
      "detail": "JSON POST の共通ラッパ。ok / status / body を返す",
      "ref": "web/apiClient.js:4"
    },
    {
      "id": "api.server.route",
      "lane": "api",
      "label": "handleRequest（ルーティング）",
      "detail": "method とパスの正規表現でハンドラに振り分ける。該当なしは404",
      "ref": "api/server.js:9"
    },
    {
      "id": "svc.orders.create",
      "lane": "svc",
      "label": "createOrder",
      "detail": "在庫確保→決済→注文作成→メールジョブの順。決済失敗時は確保した在庫を必ず戻す",
      "ref": "api/orders.js:7"
    },
    {
      "id": "svc.orders.cancel",
      "lane": "svc",
      "label": "cancelOrder",
      "detail": "confirmed 以外は409。返金失敗は同期では諦めて再試行ジョブへ委ねる",
      "ref": "api/orders.js:23"
    },
    {
      "id": "svc.inventory.reserve",
      "lane": "svc",
      "label": "reserveStock",
      "detail": "SKUごとに条件付き減算。一部でも不足したら確保分も全て戻して失敗を返す",
      "ref": "api/inventory.js:4"
    },
    {
      "id": "svc.inventory.release",
      "lane": "svc",
      "label": "releaseStock",
      "detail": "確保した在庫を戻す。決済失敗・キャンセルの両方から呼ばれる",
      "ref": "api/inventory.js:18"
    },
    {
      "id": "svc.payments.charge",
      "lane": "svc",
      "label": "chargeCard",
      "detail": "合計金額を計算しゲートウェイへ。成功したら captured で記録",
      "ref": "api/payments.js:5"
    },
    {
      "id": "svc.payments.refund",
      "lane": "svc",
      "label": "refundPayment",
      "detail": "ゲートウェイの refund API を呼び、成功なら refunded に更新",
      "ref": "api/payments.js:13"
    },
    {
      "id": "ext.payment.gateway",
      "lane": "ext",
      "label": "決済ゲートウェイ",
      "detail": "pay.example.com への HTTPS 呼び出し（Bearer 認証）",
      "ref": "api/payments.js:20"
    },
    {
      "id": "svc.jobs.enqueue",
      "lane": "svc",
      "label": "enqueueJob",
      "detail": "ワーカーへの仕事を jobs テーブルに pending で積む",
      "ref": "api/jobs.js:4"
    },
    {
      "id": "db.orders",
      "lane": "db",
      "label": "orders",
      "detail": "注文本体。status は confirmed / cancelled の2値",
      "ref": "db/schema.sql:2"
    },
    {
      "id": "db.payments",
      "lane": "db",
      "label": "payments",
      "detail": "決済記録。state は captured / refunded",
      "ref": "db/schema.sql:11"
    },
    {
      "id": "db.inventory",
      "lane": "db",
      "label": "inventory",
      "detail": "SKUごとの在庫数。CHECK (stock >= 0)",
      "ref": "db/schema.sql:17"
    },
    {
      "id": "db.jobs",
      "lane": "db",
      "label": "jobs",
      "detail": "ジョブキュー。state: pending / running / done / dead",
      "ref": "db/schema.sql:22"
    },
    {
      "id": "job.worker.loop",
      "lane": "job",
      "label": "mainLoop（5秒ポーリング）",
      "detail": "pending のジョブを SKIP LOCKED で1件ずつ取り出す常駐ループ",
      "ref": "worker/worker.js:8"
    },
    {
      "id": "job.worker.process",
      "lane": "job",
      "label": "processJob（振り分け）",
      "detail": "type で send-order-email / retry-refund に振り分け。未知の type は dead",
      "ref": "worker/worker.js:22"
    },
    {
      "id": "job.worker.send_email",
      "lane": "job",
      "label": "sendOrderEmail",
      "detail": "注文を読み、確認/キャンセルの文面を組んで送信。失敗したら pending に戻す",
      "ref": "worker/worker.js:29"
    },
    {
      "id": "job.worker.retry_refund",
      "lane": "job",
      "label": "retryRefund（最大3回）",
      "detail": "返金を再実行。失敗は attempt+1 で 60秒×attempt 後に再投入、3回で dead",
      "ref": "worker/worker.js:36"
    },
    {
      "id": "job.mailer.send",
      "lane": "job",
      "label": "sendEmail（SMTP）",
      "detail": "SMTP リレー経由で送信。例外は握って false を返す",
      "ref": "worker/mailer.js:10"
    },
    {
      "id": "ext.smtp",
      "lane": "ext",
      "label": "SMTP リレー",
      "detail": "外部メール送信サービス（587/STARTTLS）",
      "ref": "worker/mailer.js:4"
    }
  ],
  "edges": [],
  "flows": [
    {
      "id": "create-order",
      "title": "注文を確定する",
      "category": "注文",
      "trigger": "注文画面で「注文を確定する」を押す",
      "steps": [
        {
          "from": "ui.order.create_btn",
          "to": "app.client.post_json",
          "label": "POST /orders を送る",
          "kind": "http"
        },
        {
          "from": "app.client.post_json",
          "to": "api.server.route",
          "label": "ルーティングに到達",
          "kind": "http"
        },
        {
          "from": "api.server.route",
          "to": "svc.orders.create",
          "label": "createOrder を呼ぶ"
        },
        {
          "from": "svc.orders.create",
          "to": "svc.inventory.reserve",
          "label": "先に在庫を確保する"
        },
        {
          "from": "svc.inventory.reserve",
          "to": "db.inventory",
          "label": "stock >= qty の条件付きで減算",
          "kind": "db"
        },
        {
          "from": "svc.orders.create",
          "to": "svc.payments.charge",
          "label": "決済を実行"
        },
        {
          "from": "svc.payments.charge",
          "to": "ext.payment.gateway",
          "label": "ゲートウェイに charge を要求",
          "kind": "http"
        },
        {
          "from": "svc.payments.charge",
          "to": "db.payments",
          "label": "captured で決済を記録",
          "kind": "db"
        },
        {
          "from": "svc.orders.create",
          "to": "db.orders",
          "label": "注文を confirmed で作成",
          "kind": "db"
        },
        {
          "from": "svc.orders.create",
          "to": "svc.jobs.enqueue",
          "label": "確認メールのジョブを発行"
        },
        {
          "from": "svc.jobs.enqueue",
          "to": "db.jobs",
          "label": "pending で積む",
          "kind": "db"
        },
        {
          "from": "job.worker.loop",
          "to": "db.jobs",
          "label": "5秒ごとのポーリングでジョブを取得",
          "branch": "main",
          "kind": "timer"
        },
        {
          "from": "job.worker.loop",
          "to": "job.worker.process",
          "label": "取り出したジョブを処理へ"
        },
        {
          "from": "job.worker.process",
          "to": "job.worker.send_email",
          "label": "type=send-order-email を振り分け"
        },
        {
          "from": "job.worker.send_email",
          "to": "db.orders",
          "label": "宛先と注文内容を読む",
          "kind": "db"
        },
        {
          "from": "job.worker.send_email",
          "to": "job.mailer.send",
          "label": "文面を組んで送信を依頼"
        },
        {
          "from": "job.mailer.send",
          "to": "ext.smtp",
          "label": "SMTP リレーへ送信",
          "kind": "email"
        },
        {
          "from": "svc.inventory.reserve",
          "to": "svc.inventory.release",
          "label": "一部SKUが在庫不足 → 確保できた分も全て戻して409",
          "branch": "alt"
        },
        {
          "from": "svc.inventory.release",
          "to": "db.inventory",
          "label": "stock を加算して戻す",
          "branch": "alt",
          "kind": "db"
        },
        {
          "from": "svc.payments.charge",
          "to": "svc.inventory.release",
          "label": "決済が拒否された → 確保した在庫を解放して402",
          "branch": "error",
          "kind": "error"
        }
      ],
      "notes": [
        "在庫確保が先、決済が後。逆にすると「支払われたのに在庫がない」が起きる",
        "決済失敗時の在庫解放は createOrder 内で同期実行（orders.js）",
        "確認メールは同期で送らず jobs 経由。ワーカー停止中でも注文は成功する"
      ]
    },
    {
      "id": "cancel-order",
      "title": "注文をキャンセルする",
      "category": "注文",
      "trigger": "注文詳細で「キャンセルする」を押す",
      "steps": [
        {
          "from": "ui.order.cancel_btn",
          "to": "app.client.post_json",
          "label": "POST /orders/:id/cancel を送る",
          "kind": "http"
        },
        {
          "from": "app.client.post_json",
          "to": "api.server.route",
          "label": "ルーティングに到達",
          "kind": "http"
        },
        {
          "from": "api.server.route",
          "to": "svc.orders.cancel",
          "label": "cancelOrder を呼ぶ"
        },
        {
          "from": "svc.orders.cancel",
          "to": "db.orders",
          "label": "注文を取得し confirmed か確認 → cancelled に更新",
          "kind": "db"
        },
        {
          "from": "svc.orders.cancel",
          "to": "svc.payments.refund",
          "label": "返金を実行"
        },
        {
          "from": "svc.payments.refund",
          "to": "ext.payment.gateway",
          "label": "refund API を呼ぶ",
          "kind": "http"
        },
        {
          "from": "svc.payments.refund",
          "to": "db.payments",
          "label": "refunded に更新",
          "kind": "db"
        },
        {
          "from": "svc.orders.cancel",
          "to": "svc.inventory.release",
          "label": "在庫を戻す"
        },
        {
          "from": "svc.inventory.release",
          "to": "db.inventory",
          "label": "stock を加算",
          "kind": "db"
        },
        {
          "from": "svc.orders.cancel",
          "to": "svc.jobs.enqueue",
          "label": "キャンセルメールのジョブを発行"
        },
        {
          "from": "svc.jobs.enqueue",
          "to": "db.jobs",
          "label": "pending で積む",
          "kind": "db"
        },
        {
          "from": "job.worker.loop",
          "to": "db.jobs",
          "label": "5秒ごとのポーリングでジョブを取得",
          "branch": "main",
          "kind": "timer"
        },
        {
          "from": "job.worker.loop",
          "to": "job.worker.process",
          "label": "取り出したジョブを処理へ"
        },
        {
          "from": "job.worker.process",
          "to": "job.worker.send_email",
          "label": "type=send-order-email を振り分け"
        },
        {
          "from": "job.worker.send_email",
          "to": "db.orders",
          "label": "宛先と注文内容を読む",
          "kind": "db"
        },
        {
          "from": "job.worker.send_email",
          "to": "job.mailer.send",
          "label": "文面を組んで送信を依頼"
        },
        {
          "from": "job.mailer.send",
          "to": "ext.smtp",
          "label": "SMTP リレーへ送信",
          "kind": "email"
        },
        {
          "from": "svc.payments.refund",
          "to": "svc.jobs.enqueue",
          "label": "返金が失敗 → retry-refund ジョブに委ねて処理は続行",
          "branch": "error",
          "kind": "retry"
        }
      ],
      "notes": [
        "返金失敗でもキャンセル自体は成立させる（在庫解放・状態更新は行う）。返金だけ再試行ジョブへ",
        "confirmed 以外の注文は 409 not_cancellable"
      ]
    },
    {
      "id": "retry-refund-job",
      "title": "返金の自動再試行",
      "category": "自動処理",
      "trigger": "自動: 返金失敗の60秒×attempt後",
      "steps": [
        {
          "from": "job.worker.loop",
          "to": "db.jobs",
          "label": "retry-refund ジョブを取得",
          "branch": "main",
          "kind": "timer"
        },
        {
          "from": "job.worker.loop",
          "to": "job.worker.process",
          "label": "処理へ"
        },
        {
          "from": "job.worker.process",
          "to": "job.worker.retry_refund",
          "label": "type=retry-refund を振り分け"
        },
        {
          "from": "job.worker.retry_refund",
          "to": "svc.payments.refund",
          "label": "返金を再実行"
        },
        {
          "from": "svc.payments.refund",
          "to": "ext.payment.gateway",
          "label": "refund API を呼ぶ",
          "kind": "http"
        },
        {
          "from": "svc.payments.refund",
          "to": "db.payments",
          "label": "成功したら refunded に更新",
          "kind": "db"
        },
        {
          "from": "job.worker.retry_refund",
          "to": "db.jobs",
          "label": "成功: done ／ 失敗: attempt+1 で再投入（3回目は dead）",
          "kind": "retry"
        }
      ],
      "notes": [
        "試行間隔は 60秒 × attempt の線形バックオフ",
        "3回失敗で dead。dead は人間の対応に回す想定"
      ]
    },
    {
      "id": "send-mail-job",
      "title": "注文メールの送信",
      "category": "自動処理",
      "trigger": "自動: メールジョブ取得ごと",
      "steps": [
        {
          "from": "job.worker.loop",
          "to": "db.jobs",
          "label": "5秒ごとのポーリングでジョブを取得",
          "branch": "main",
          "kind": "timer"
        },
        {
          "from": "job.worker.loop",
          "to": "job.worker.process",
          "label": "取り出したジョブを処理へ"
        },
        {
          "from": "job.worker.process",
          "to": "job.worker.send_email",
          "label": "type=send-order-email を振り分け"
        },
        {
          "from": "job.worker.send_email",
          "to": "db.orders",
          "label": "宛先と注文内容を読む",
          "kind": "db"
        },
        {
          "from": "job.worker.send_email",
          "to": "job.mailer.send",
          "label": "文面を組んで送信を依頼"
        },
        {
          "from": "job.mailer.send",
          "to": "ext.smtp",
          "label": "SMTP リレーへ送信",
          "kind": "email"
        },
        {
          "from": "job.worker.send_email",
          "to": "db.jobs",
          "label": "送信に失敗 → pending に戻して次回再試行",
          "branch": "error",
          "kind": "retry"
        }
      ],
      "notes": [
        "確認・キャンセルの両方がこのジョブを通る（kind で文面を出し分け）"
      ]
    }
  ]
}